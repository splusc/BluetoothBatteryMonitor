<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\BluetoothBatteryMonitor.ico</ApplicationIcon>
    <Product>蓝牙电量监视器</Product>
    <AssemblyTitle>蓝牙电量监视器</AssemblyTitle>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 常驻托盘没有高吞吐热路径，关闭分层编译以减少多级 JIT 的代码与元数据开销。 -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="BluetoothBatteryMonitor.Checks" />
    <!-- 图形嵌入程序集，单文件发布无需额外素材目录。 -->
    <EmbeddedResource Include="Assets\DeviceIcons\*.png" />
    <!-- 将第三方图形许可同时包含在单文件发布的程序集内。 -->
    <EmbeddedResource Include="Assets\DeviceIcons\LICENSE.txt" />
  </ItemGroup>
</Project>
